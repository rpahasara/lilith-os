[Unit]
Description=LILITH DEV_SYNTHETIC recovery witness owner socket (DEV only, root-only)
Requires=systemd-tmpfiles-setup.service
After=systemd-tmpfiles-setup.service
AssertPathIsDirectory=/run/lilith-recovery-witness

[Socket]
ListenStream=/run/lilith-recovery-witness/owner.sock
Accept=no
Service=lilith-recovery-witness.service
FileDescriptorName=owner
SocketUser=root
SocketGroup=root
SocketMode=0600
DirectoryMode=0710
FlushPending=yes
RemoveOnStop=yes
Backlog=16
TriggerLimitIntervalSec=60
TriggerLimitBurst=3
