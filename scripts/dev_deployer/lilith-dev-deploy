#!/bin/bash
# LILITH 15B2b-B1c fixed DEV Core API deployment helper.
#
# Installed by the owner (break-glass) as root:root 0755 at
# /usr/local/sbin/lilith-dev-deploy. The routine DEV deployer may run exactly
# this program through sudo. It accepts no path, command, interpreter, unit, or
# environment input. The bundle arrives on stdin as a tar containing exactly
# lilith-core-api.tar.gz and lilith-core-api.attestation.json.
#
# Root is used only to buffer stdin, drop to the application user, and
# restart lilith-os-api-dev.service. Every bundle byte is parsed, verified,
# tested, and installed as the application user. It never touches the Memory
# Broker, owner services, identities, authorizations, Stage III, activation
# configuration, or PROD.
set -Eeuo pipefail
umask 077
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
export LC_ALL=C
# sudo/runuser keep the caller's cwd (the deployer's private OS Login home),
# which the application user cannot traverse. Run everything from /.
cd /

readonly APP_USER="lilith"
readonly APP_ROOT="/home/lilith/.hermes/lilith-os-dev"
readonly RELEASES_DIR="${APP_ROOT}/releases"
readonly CURRENT_LINK="${APP_ROOT}/current"
readonly VENV_DIR="${APP_ROOT}/api-venv"
readonly SERVICE_NAME="lilith-os-api-dev.service"
readonly HEALTH_URL="http://127.0.0.1:8765/health"
readonly LIB_DIR="/usr/local/lib/lilith-dev-deploy"
readonly VERIFIER="${LIB_DIR}/verify_core_api_bundle.py"
readonly PROBE="${LIB_DIR}/run_core_api_dev_durability_probe.py"
readonly MAX_PAYLOAD_BYTES=$((64 * 1024 * 1024))
readonly LOCK_PATH="/run/lilith-dev-deploy.lock"
readonly WORK_PARENT="/var/tmp"
readonly BUNDLE_NAME="lilith-core-api.tar.gz"
readonly ATTESTATION_NAME="lilith-core-api.attestation.json"

# Deployment state is global and initialized here: the EXIT trap runs after
# function locals are gone, so it must never depend on them.
CANDIDATE_SHA=""
STAGING=""
WORK=""
PREVIOUS_RELEASE=""
SWITCHED=0
RESTARTED=0
PROBE_PREPARED=0
COMPLETED=0

die() {
  echo "lilith-dev-deploy: $*" >&2
  exit 2
}

usage() {
  die "usage: lilith-dev-deploy deploy <40-hex-sha> < payload.tar | lilith-dev-deploy status"
}

as_app() {
  runuser -u "${APP_USER}" -- env -i \
    PATH=/usr/bin:/bin HOME=/home/lilith LC_ALL=C PYTHONDONTWRITEBYTECODE=1 "$@"
}

manifest_sha() {
  as_app "${VENV_DIR}/bin/python" -c \
    'import json,sys; print(json.load(open(sys.argv[1], encoding="utf-8"))["candidateSha"])' "$1"
}

status() {
  systemctl is-active "${SERVICE_NAME}"
  echo "current=$(as_app readlink -f "${CURRENT_LINK}")"
  echo "candidateSha=$(manifest_sha "${CURRENT_LINK}/deployment-manifest.json")"
  echo "bundleSha256=$(as_app cat "${CURRENT_LINK}/.bundle-sha256")"
}

# Restore the previous release link. The service is restarted (or stopped when
# there is no previous release) only if this run already restarted it; before
# that, the running process still executes the previous release.
rollback() {
  echo "--- DEV BUNDLE ROLLBACK ---"
  if [[ -n "${PREVIOUS_RELEASE}" ]] && as_app test -d "${PREVIOUS_RELEASE}"; then
    local rollback_link="${APP_ROOT}/.current.rollback.$$"
    as_app ln -s "${PREVIOUS_RELEASE}" "${rollback_link}"
    as_app mv -Tf "${rollback_link}" "${CURRENT_LINK}"
    if [[ "${RESTARTED}" == 1 ]]; then
      systemctl restart "${SERVICE_NAME}"
      sleep 3
      as_app curl -fsS "${HEALTH_URL}"
      echo
    fi
  elif [[ "${RESTARTED}" == 1 ]]; then
    systemctl stop "${SERVICE_NAME}"
  fi
  SWITCHED=0
}

cleanup() {
  local status=$?
  set +e
  if [[ "${COMPLETED}" != 1 && "${SWITCHED}" == 1 ]]; then
    rollback
  fi
  if [[ "${PROBE_PREPARED}" == 1 ]]; then
    as_app "${VENV_DIR}/bin/python" "${PROBE}" cleanup --candidate-sha "${CANDIDATE_SHA}"
  fi
  if [[ -n "${STAGING}" ]]; then
    as_app rm -rf --one-file-system -- "${STAGING}"
  fi
  if [[ -n "${WORK}" ]]; then
    rm -rf --one-file-system -- "${WORK}"
  fi
  exit "${status}"
}

deploy() {
  local release_dir size pre_pid post_pid next_link
  CANDIDATE_SHA="$1"
  release_dir="${RELEASES_DIR}/${CANDIDATE_SHA}"

  exec 9>"${LOCK_PATH}"
  flock -n 9 || die "another DEV deployment is running"
  trap cleanup EXIT

  test -x "${VENV_DIR}/bin/python" || die "DEV runtime is not bootstrapped"
  test -d "${RELEASES_DIR}" || die "DEV release root is missing"
  test -f "${VERIFIER}" -a -f "${PROBE}" || die "pinned deployment controls are missing"
  test "$(systemctl is-enabled "${SERVICE_NAME}")" = enabled || die "DEV service is not enabled"

  echo "--- REMOVE STALE ARTIFACTS OF ABORTED RUNS (UNDER LOCK) ---"
  as_app find "${RELEASES_DIR}" -mindepth 1 -maxdepth 1 -type d -name '.*.staging.*' \
    -exec rm -rf --one-file-system -- {} +
  find "${WORK_PARENT}" -mindepth 1 -maxdepth 1 -type d -user root -name 'lilith-dev-deploy.*' \
    -exec rm -rf --one-file-system -- {} +

  if as_app test -L "${CURRENT_LINK}"; then
    PREVIOUS_RELEASE="$(as_app readlink -f "${CURRENT_LINK}")"
  fi

  echo "--- RECEIVE BOUNDED PAYLOAD ---"
  WORK="$(mktemp -d "${WORK_PARENT}/lilith-dev-deploy.XXXXXXXX")"
  head -c "$((MAX_PAYLOAD_BYTES + 1))" > "${WORK}/payload.tar"
  size="$(stat -c %s -- "${WORK}/payload.tar")"
  (( size > 0 && size <= MAX_PAYLOAD_BYTES )) || die "payload size ${size} is outside bounds"

  echo "--- UNPACK PAYLOAD AS ${APP_USER} ---"
  STAGING="${RELEASES_DIR}/.${CANDIDATE_SHA}.staging.$$"
  as_app mkdir -m 700 -- "${STAGING}" "${STAGING}/in" "${STAGING}/release"
  as_app tar -x -f - -C "${STAGING}/in" --no-same-owner --no-same-permissions \
    -- "${BUNDLE_NAME}" "${ATTESTATION_NAME}" < "${WORK}/payload.tar"
  test "$(as_app find "${STAGING}/in" -mindepth 1 -printf '%y %f\n' | sort | tr '\n' ' ')" = \
    "f ${ATTESTATION_NAME} f ${BUNDLE_NAME} " || die "payload must contain exactly the bundle and attestation"

  echo "--- VERIFY AND EXTRACT EXACT-SHA BUNDLE ---"
  as_app "${VENV_DIR}/bin/python" "${VERIFIER}" \
    --archive "${STAGING}/in/${BUNDLE_NAME}" \
    --attestation "${STAGING}/in/${ATTESTATION_NAME}" \
    --destination "${STAGING}/release" \
    --expected-sha "${CANDIDATE_SHA}"

  echo "--- PRE-INSTALL VALIDATION ---"
  test "$(manifest_sha "${STAGING}/release/deployment-manifest.json")" = "${CANDIDATE_SHA}"
  as_app "${VENV_DIR}/bin/python" -m compileall -q "${STAGING}/release/app.py" "${STAGING}/release/lilith_memory"

  echo "--- INSTALL DEV PYTHON DEPENDENCIES ---"
  as_app "${VENV_DIR}/bin/python" -m pip install --disable-pip-version-check \
    -r "${STAGING}/release/requirements.txt"

  echo "--- RUN ISOLATED DEV SYNTHETIC TESTS ---"
  as_app LILITH_ENV=test "${VENV_DIR}/bin/python" -m unittest discover \
    -s "${STAGING}/release/tests" -p 'test_*.py'

  if as_app test -d "${release_dir}"; then
    echo "--- VERIFY EXISTING IMMUTABLE RELEASE ---"
    as_app cmp -s "${STAGING}/release/deployment-manifest.json" "${release_dir}/deployment-manifest.json"
    as_app cmp -s "${STAGING}/release/.bundle-sha256" "${release_dir}/.bundle-sha256"
  else
    echo "--- INSTALL IMMUTABLE RELEASE ---"
    as_app find "${STAGING}/release" -type d -exec chmod 750 {} +
    as_app find "${STAGING}/release" -type f -exec chmod 640 {} +
    as_app mv -T -- "${STAGING}/release" "${release_dir}"
  fi

  echo "--- ATOMIC DEV RELEASE SWITCH ---"
  pre_pid="$(systemctl show --property=MainPID --value "${SERVICE_NAME}")"
  [[ "${pre_pid}" =~ ^[1-9][0-9]*$ ]] || die "DEV service has no pre-restart PID"
  next_link="${APP_ROOT}/.current.${CANDIDATE_SHA}.$$"
  as_app ln -s "${release_dir}" "${next_link}"
  SWITCHED=1
  as_app mv -Tf "${next_link}" "${CURRENT_LINK}"

  echo "--- PREPARE PERSISTENT DEV CANONICAL DURABILITY PROBE ---"
  systemctl show "${SERVICE_NAME}" \
    --property=MainPID,NRestarts,ActiveState,SubState,ActiveEnterTimestamp --no-pager
  PROBE_PREPARED=1
  as_app LILITH_ENV=dev "${VENV_DIR}/bin/python" "${PROBE}" prepare \
    --candidate-sha "${CANDIDATE_SHA}" --pre-restart-pid "${pre_pid}"

  echo "--- RESTART DEV SERVICE ---"
  RESTARTED=1
  systemctl restart "${SERVICE_NAME}"
  sleep 3

  echo "--- VERIFY DEV SERVICE AND HEALTH ---"
  if ! systemctl is-active --quiet "${SERVICE_NAME}"; then
    journalctl -u "${SERVICE_NAME}" -n 50 --no-pager || true
    exit 1
  fi
  if ! as_app curl -fsS "${HEALTH_URL}"; then
    echo
    journalctl -u "${SERVICE_NAME}" -n 50 --no-pager || true
    exit 1
  fi
  echo
  post_pid="$(systemctl show --property=MainPID --value "${SERVICE_NAME}")"
  if [[ ! "${post_pid}" =~ ^[1-9][0-9]*$ || "${post_pid}" == "${pre_pid}" ]]; then
    echo "DEV service restart did not establish a new process." >&2
    exit 1
  fi
  systemctl show "${SERVICE_NAME}" \
    --property=MainPID,NRestarts,ActiveState,SubState,ActiveEnterTimestamp --no-pager

  echo "--- VERIFY PERSISTENT DEV CANONICAL DURABILITY IN NEW PROCESS ---"
  as_app LILITH_ENV=dev "${VENV_DIR}/bin/python" "${PROBE}" verify \
    --candidate-sha "${CANDIDATE_SHA}" --post-restart-pid "${post_pid}"

  echo "--- CLEAN UP SYNTHETIC DEV DURABILITY ENVIRONMENT ---"
  as_app "${VENV_DIR}/bin/python" "${PROBE}" cleanup --candidate-sha "${CANDIDATE_SHA}"
  PROBE_PREPARED=0

  echo "--- POST-INSTALL IDENTITY READBACK ---"
  test "$(as_app readlink -f "${CURRENT_LINK}")" = "${release_dir}"
  test "$(manifest_sha "${CURRENT_LINK}/deployment-manifest.json")" = "${CANDIDATE_SHA}"
  as_app cat "${CURRENT_LINK}/deployment-manifest.json"
  as_app cat "${CURRENT_LINK}/.bundle-sha256"
  COMPLETED=1
  echo "--- DEV DEPLOYMENT COMPLETE ---"
}

case "${1:-}" in
  deploy)
    [[ "$#" -eq 2 && "$2" =~ ^[0-9a-f]{40}$ ]] || usage
    deploy "$2"
    ;;
  status)
    [[ "$#" -eq 1 ]] || usage
    status
    ;;
  *)
    usage
    ;;
esac
