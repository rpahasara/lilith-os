[Unit]
Description=Hermes Agent Gateway - Messaging Platform Integration
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=lilith
Group=lilith
ExecStart=/home/lilith/.hermes/hermes-agent/venv/bin/python -m hermes_cli.main gateway run
WorkingDirectory=/home/lilith/.hermes
Environment="HOME=/home/lilith"
Environment="USER=lilith"
Environment="LOGNAME=lilith"
Environment="PATH=/home/lilith/.hermes/node:/home/lilith/.hermes/hermes-agent/venv/bin:/home/lilith/.hermes/hermes-agent/node_modules/.bin:/home/lilith/.hermes/node/bin:/home/lilith/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="VIRTUAL_ENV=/home/lilith/.hermes/hermes-agent/venv"
Environment="HERMES_HOME=/home/lilith/.hermes"
Restart=always
RestartSec=5
RestartForceExitStatus=75
RestartPreventExitStatus=78
KillMode=mixed
KillSignal=SIGTERM
ExecReload=/bin/kill -USR1 $MAINPID
ExecStopPost=-/home/lilith/.hermes/hermes-agent/venv/bin/python -m gateway.cgroup_cleanup
TimeoutStopSec=60
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
