import re
import sqlite3
import subprocess
from pathlib import Path
from datetime import datetime, timezone

from fastapi import FastAPI, HTTPException

HOME = Path.home()
DB = HOME / ".hermes/lilith-os/data/lilith.db"

app = FastAPI(
    title="LILITH OS API",
    version="0.1.0",
    docs_url="/docs",
    redoc_url=None,
