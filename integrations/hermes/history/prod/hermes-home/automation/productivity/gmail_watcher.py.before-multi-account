def main():
    model_calls = 0

    config = load_json(CONFIG_PATH, None)

    if not config:
        log("ERROR config missing or invalid")
        return 1

    state = load_json(
        STATE_PATH,
        {
            "seen_message_ids": [],
            "last_poll_utc": None
        }
    )

    seen = set(state.get("seen_message_ids", []))

    creds = load_credentials()

    service = build(
        "gmail",
        "v1",
        credentials=creds,
        cache_discovery=False
    )

    lookback = int(config["gmail"]["lookback_minutes"])

    after = datetime.now(timezone.utc) - timedelta(minutes=lookback)

    # Gmail query works in epoch seconds.
    query = f"after:{int(after.timestamp())}"

    result = (
        service.users()
        .messages()
        .list(
            userId="me",
            q=query,
            maxResults=int(config["gmail"]["max_messages_per_poll"])
        )
        .execute()
    )

    refs = result.get("messages", [])

    new_candidates = []

    for ref in refs:
        message_id = ref["id"]

        if message_id in seen:
            continue

        msg = (
            service.users()
            .messages()
            .get(
                userId="me",
                id=message_id,
                format="metadata",
                metadataHeaders=[
                    "From",
                    "Subject",
                    "Date"
                ]
            )
            .execute()
        )

        headers = msg.get("payload", {}).get("headers", [])

        sender = normalize(get_header(headers, "From"))
        subject = normalize(get_header(headers, "Subject"))
        date_header = normalize(get_header(headers, "Date"))
        snippet = normalize(msg.get("snippet", ""))

        score, reasons = score_message(
            sender,
            subject,
            snippet,
            config
        )

        candidate_for_resolution = {
            "message_id": message_id,
            "thread_id": msg.get("threadId"),
            "sender_name": parseaddr(sender)[0],
            "sender_email": parseaddr(sender)[1],
            "subject": subject,
            "date": date_header,
            "snippet": snippet[:500],
            "score": score,
            "reasons": reasons
        }

        try:
            resolution_result = maybe_resolve_followups(
                candidate_for_resolution
            )

            if isinstance(resolution_result, dict):
                model_calls += resolution_result.get("model_calls", 0)
            else:
                model_calls += resolution_result
        except Exception as exc:
            log(
                f"RESOLUTION_ERROR message_id={message_id} "
                f"{type(exc).__name__}: {exc}"
            )

        seen.add(message_id)

        if score >= 3:
            name, email = parseaddr(sender)

            candidate = {
                "message_id": message_id,
                "thread_id": msg.get("threadId"),
                "sender_name": name,
                "sender_email": email,
                "subject": subject,
                "date": date_header,
                "snippet": snippet[:500],
                "score": score,
                "reasons": reasons
            }

            should_alert = False
            decision_source = "python"

            if score >= 8:
                should_alert = True
            else:
                decision_source = "lilith"

                try:
                    model_calls += 1
                    should_alert = lilith_judge_candidate(candidate)

                    log(
                        f"LILITH_JUDGMENT message_id={message_id} "
                        f"score={score} "
                        f"verdict={'ALERT' if should_alert else 'IGNORE'}"
                    )
                except Exception as exc:
                    # Fail closed: classifier problems must not spam the user.
                    should_alert = False

                    log(
                        f"LILITH_JUDGMENT_ERROR message_id={message_id} "
                        f"{type(exc).__name__}: {exc}"
                    )

            if should_alert:
                new_candidates.append(candidate)

                try:
                    send_urgent_alert(candidate)

                    log(
                        f"ALERT_SENT message_id={message_id} "
                        f"score={score} source={decision_source} "
                        f"subject={subject!r}"
                    )
                except Exception as exc:
                    log(
                        f"ALERT_ERROR message_id={message_id} "
                        f"{type(exc).__name__}: {exc}"
                    )

            try:
                created_followup = maybe_create_followup(candidate)

                if created_followup:
                    log(
                        f"FOLLOWUP_ADDED message_id={message_id} "
                        f"subject={subject!r}"
                    )
            except Exception as exc:
                log(
                    f"FOLLOWUP_ERROR message_id={message_id} "
                    f"{type(exc).__name__}: {exc}"
                )

            log(
                f"CANDIDATE score={score} "
                f"from={email or sender!r} "
                f"subject={subject!r} "
                f"reasons={reasons}"
            )

    # Prevent infinite growth while retaining plenty of dedupe history.
    ordered_seen = list(seen)[-5000:]

    state["seen_message_ids"] = ordered_seen
    state["last_poll_utc"] = datetime.now(timezone.utc).isoformat()

    save_json(STATE_PATH, state)
    STATE_PATH.chmod(0o600)

    candidate_path = BASE / "state" / "urgent_candidates.json"

    existing = load_json(candidate_path, [])

    known_candidate_ids = {
        item.get("message_id")
        for item in existing
    }

    for candidate in new_candidates:
        if candidate["message_id"] not in known_candidate_ids:
            existing.append(candidate)

    existing = existing[-500:]

    save_json(candidate_path, existing)
    candidate_path.chmod(0o600)

    log(
        f"OK checked={len(refs)} "
        f"new_candidates={len(new_candidates)} "
        f"model_calls={model_calls}"
    )

    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as exc:
        log(f"ERROR {type(exc).__name__}: {exc}")
        sys.exit(1)
