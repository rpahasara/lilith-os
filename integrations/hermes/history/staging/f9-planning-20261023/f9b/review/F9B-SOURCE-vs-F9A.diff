+def _content_free_request_dump(payload: Dict[str, Any]) -> Dict[str, Any]:
+    """F9-B (LILITH DEV): a request debug dump without conversation content.
+
+    Keeps what diagnoses a failed call (reason, endpoint, model and scalar
+    parameters, message roles and sizes, tool names, error type/status/code)
+    and drops message text, structured parameters and provider error bodies,
+    which can echo the request.
+    """
+    def _size(value) -> int:
+        if isinstance(value, list):
+            return sum(_size(v.get("text", "") if isinstance(v, dict) else v) for v in value)
+        return 0 if value is None else len(value if isinstance(value, str) else str(value))
+
+    out = dict(payload)
+    request = dict(out.get("request") or {})
+    safe: Dict[str, Any] = {}
+    for key, value in (request.get("body") or {}).items():
+        if key in ("messages", "input") and isinstance(value, list):
+            safe[key] = [{"role": m.get("role"), "chars": _size(m.get("content"))} if isinstance(m, dict)
+                         else {"chars": _size(m)} for m in value]
+        elif key == "tools" and isinstance(value, list):
+            safe[key] = [((t.get("function") or {}).get("name") or t.get("name")) if isinstance(t, dict) else None
+                         for t in value]
+        elif value is None or isinstance(value, (bool, int, float)):
+            safe[key] = value
+        elif key in _DUMP_SAFE_STR_KEYS and isinstance(value, str):
+            safe[key] = value
+        else:
+            safe[key] = f"<{type(value).__name__} omitted>"
+    request["body"] = safe
+    out["request"] = request
+    if isinstance(out.get("error"), dict):
+        out["error"] = {k: v for k, v in out["error"].items()
+                        if k in _DUMP_SAFE_ERROR_KEYS and (v is None or isinstance(v, (str, int, float, bool)))}
+    out["content_free"] = True
+    return out
+
