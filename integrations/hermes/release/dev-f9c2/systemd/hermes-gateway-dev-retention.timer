[Unit]
Description=Daily LILITH Hermes gateway DEV retention

[Timer]
OnCalendar=*-*-* 03:30:00 UTC
RandomizedDelaySec=15min
Persistent=true

# Static on purpose: pulled in by hermes-gateway-dev.service (Wants=); never enabled (no unit-link change on DEV).
# After a reboot nothing runs until the gateway is started again; Persistent=true then catches up immediately.
