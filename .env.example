# ─────────────────────────────────────────────────────────────────────────
# LILITH OS — backend connection
#
# The backend is PRIVATE. Point these at a localhost SSH/IAP tunnel, never at a
# public URL. Choose ONE of the two modes below.
# ─────────────────────────────────────────────────────────────────────────

# MODE 1 — Same-origin proxy (RECOMMENDED)
# Server-only variable: the URL never reaches the browser, and there is no CORS.
# The frontend calls /api/lilith/* and Next forwards to this address.
# Example with a tunnel:  ssh -L 8000:localhost:8000 <host>   →   set:
LILITH_API_URL=http://localhost:8000

# MODE 2 — Direct from the browser (only if you can't use the proxy)
# Exposed to the client bundle; the backend must allow this origin via CORS.
# Leave this UNSET when using MODE 1.
# NEXT_PUBLIC_LILITH_API_URL=http://localhost:8000

# Explicit development/demo command fixtures. Keep disabled for normal LILITH use.
# Development server only: a production build ignores this flag.
NEXT_PUBLIC_LILITH_ENABLE_DEMO_COMMANDS=false

# Sample data for the workspaces (Career, Automations, Meetings, Memory).
# OFF by default: a workspace that cannot reach the backend says it is
# unavailable and shows nothing invented. Set to true only for development
# without a backend; every page using sample data is then marked "Simulated
# data". Never set this for real LILITH use.
# Development server only: a production build ignores this flag, so sample
# data can never appear in a built release.
NEXT_PUBLIC_LILITH_DEMO_DATA=false

# ─────────────────────────────────────────────────────────────────────────
# HOSTED WEB PREVIEW (owner-only, behind Cloudflare Tunnel + Access)
#
# Leave LILITH_HOSTED unset for local use (existing behaviour). With
# LILITH_HOSTED=1 every request (pages, API, assets) must carry a valid
# Cloudflare Access token for an allowed owner email; any missing or invalid
# setting below refuses ALL requests (fail closed). All values are server-only:
# never prefix them with NEXT_PUBLIC_, and keep NEXT_PUBLIC_LILITH_API_URL unset.
# Cloudflare sign-in is NOT owner authority: it never enables evidence capture,
# memory approvals, erasure, canonical writes or relationship signing.
# ─────────────────────────────────────────────────────────────────────────
# LILITH_HOSTED=1
# LILITH_ACCESS_TEAM_DOMAIN=<team>.cloudflareaccess.com
# LILITH_ACCESS_AUD=<64-hex Access application AUD tag>
# LILITH_OWNER_EMAILS=<owner email>[,<second owner email>]
# LILITH_PUBLIC_ORIGIN=https://<public host>
