# ─────────────────────────────────────────────────────────────────────────
# LILITH OS — backend connection
#
# The backend is PRIVATE. Point these at a localhost SSH/IAP tunnel, never at a
# public URL. Choose ONE of the two modes below.
# ─────────────────────────────────────────────────────────────────────────

# MODE 1 — Same-origin proxy (RECOMMENDED)
# Server-only variable: the URL never reaches the browser, and there is no CORS.
# The frontend calls /api/lilith/* and Next forwards to this address.
# Example with a tunnel:  ssh -L 8000:localhost:8000 <host>   →   set:
LILITH_API_URL=http://localhost:8000

# MODE 2 — Direct from the browser (only if you can't use the proxy)
# Exposed to the client bundle; the backend must allow this origin via CORS.
# Leave this UNSET when using MODE 1.
# NEXT_PUBLIC_LILITH_API_URL=http://localhost:8000

# Explicit development/demo command fixtures. Keep disabled for normal LILITH use.
NEXT_PUBLIC_LILITH_ENABLE_DEMO_COMMANDS=false
