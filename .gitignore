# ==============================
# LILITH - Git Ignore Rules
# ==============================

# Environment / secrets
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
credentials.json
service-account*.json

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js / frontend build output
/.next/
/out/
/build
/dist

# Testing / coverage
/coverage
.pytest_cache/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.ruff_cache/

# Runtime databases / local state
*.db
*.sqlite
*.sqlite3

# Logs
*.log
/logs/

# IDE / operating system
.idea/
.vscode/
.DS_Store
Thumbs.db

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Temporary / backup files
/tmp/
*.tmp
*.bak
*.backup
