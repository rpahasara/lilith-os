# LILITH private web preview: SERVER-ONLY environment (TEMPLATE, not installed).
# Install as /etc/lilith-web/env, owner root, group lilith-web, mode 0640.
# Never prefix anything with NEXT_PUBLIC_. Never commit a filled-in copy.
# Verify:  node scripts/check-web-readiness.mjs --env /etc/lilith-web/env

# Hosted authentication (H1). Any missing/invalid value refuses ALL requests.
LILITH_HOSTED=1
LILITH_ACCESS_TEAM_DOMAIN=<team>.cloudflareaccess.com
LILITH_ACCESS_AUD=<64-hex Access application AUD tag>
LILITH_OWNER_EMAILS=<owner email>
LILITH_PUBLIC_ORIGIN=https://<PUBLIC_HOSTNAME>

# Core API on its PRIVATE network address (separate VM; never loopback, never public).
LILITH_API_URL=http://<core-api-internal-ip-or-name.internal>:8765
LILITH_OS_READ_TOKEN=<32+ char read token>
LILITH_OS_WRITE_TOKEN=<32+ char write token, different from the read token>
# Do NOT set LILITH_OS_OWNER_CAPTURE_TOKEN here: owner capture is not a web capability.

# Voice (optional; same providers and voices as today).
# ELEVENLABS_API_KEY=<key>
# OPENAI_API_KEY=<key>
